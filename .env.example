# Frontend -> perception backend URL.
# Dev default is http://localhost:8000. For production, set this to your deployed API.
VITE_API_BASE=http://localhost:8000

# Roof shape when you press R. Default (unset) = flat RCC slab on the footprint,
# which is what Indian residential plans are. Set to 1 only for a plan that
# genuinely has a pitched/hip roof.
VITE_PITCHED_ROOF=0
